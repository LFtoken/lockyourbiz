          <li><a href="/blog/small-business-backup-strategy/" class="text-primary-700 hover:underline font-medium">Backup Strategy Guide →</a></li>
          <li><a href="/incident-response/data-breach/" class="text-primary-700 hover:underline font-medium">Data Breach Response Guide →</a></li>
        </ul>
      </div>
    </article>
  </div>
</BaseLayout>
